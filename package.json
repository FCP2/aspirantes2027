    "express": "^5.1.0",
    "express-session": "^1.18.1",
    "leaflet": "^1.9.4",
    "multer": "^2.0.2",
    "pdf-lib": "^1.17.1",
    "pg": "^8.16.3",
    "puppeteer": "^24.16.0",
