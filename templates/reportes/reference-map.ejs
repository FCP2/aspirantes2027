<!doctype html>
<html lang="es-MX"><head><meta charset="utf-8"><style>
@page{size:letter landscape;margin:0}
*{box-sizing:border-box}html,body{margin:0;background:#eee7da;color:#5b2434;font-family:Arial,sans-serif;-webkit-print-color-adjust:exact;print-color-adjust:exact}
.page{width:279.4mm;height:215.9mm;position:relative;overflow:hidden;background:#f3eee5;page-break-after:always;padding:15mm 16mm 13mm}.page:last-child{page-break-after:auto}.page::after{content:"";position:absolute;left:0;right:0;bottom:0;height:7mm;background:#8f173d}
.header{position:absolute;left:16mm;right:16mm;top:0;height:14mm;padding:4mm 7mm;background:#ccb58f;color:#fff;font-size:13pt;font-weight:700;box-shadow:0 2mm 2mm rgba(0,0,0,.2)}
.summary{display:grid;grid-template-columns:1.85fr 1fr;gap:7mm;height:100%;padding-top:8mm}.map{display:grid;place-items:center}.map svg{width:100%;height:100%;filter:drop-shadow(0 2mm 2mm rgba(75,42,29,.22))}.map-labels text{font-size:4px;font-weight:700;fill:#fff;paint-order:stroke;stroke:#71102e;stroke-width:1.05px;stroke-linejoin:round}
.profile{display:flex;flex-direction:column;justify-content:center;align-items:center;text-align:center}.profile small{font-size:8pt;color:#a23131}.profile h1{margin:2mm 0 3mm;font-size:15pt;line-height:1.08;text-transform:uppercase}.profile-photo{width:29mm;height:29mm;object-fit:cover;border-radius:50%;border:1mm solid #fff;box-shadow:0 1mm 3mm rgba(0,0,0,.18);background:#ddd}.has-reference-color .profile-photo{border:1.6mm solid var(--reference-color);box-shadow:0 0 0 .8mm #fff,0 1mm 3mm rgba(0,0,0,.22)}.profile-placeholder{display:grid;place-items:center;color:#8f173d;font-size:19pt}
.count{margin-top:4mm;display:grid;grid-template-columns:repeat(2,1fr);gap:2mm;width:100%}.count div{padding:3mm 1mm;background:rgba(255,255,255,.62);border-top:1mm solid #ccb58f}.count span,.count strong{display:block}.count span{font-size:5.5pt;color:#8c8178}.count strong{font-size:15pt;color:#8f173d}.variants{margin-top:2.5mm;font-size:5.7pt;line-height:1.3;color:#7b6e65}.review-note{display:inline-block;margin-top:2.5mm;padding:1.5mm 2.5mm;border:1px solid #d5b36e;background:#fff7e6;color:#8c5d16;font-size:6pt}.folio{position:absolute;right:10mm;bottom:10mm;color:#a37137;font-size:9pt;font-weight:700}.generated{position:absolute;left:16mm;bottom:10mm;color:#8a8178;font-size:6pt}
.detail{padding-top:23mm}.detail h2{margin:0 0 4mm;font-size:14pt}.cards{display:grid;grid-template-columns:1fr 1fr;gap:4mm 8mm}.card{min-height:38mm;display:grid;grid-template-columns:25mm 1fr;gap:4mm;align-items:center;border-top:8mm solid #ccb58f;padding:3mm;background:rgba(255,255,255,.30);position:relative}.card .municipio{position:absolute;top:-6.3mm;left:3mm;color:#fff;font-size:8pt}.card img,.photo-empty{width:23mm;height:25mm;object-fit:cover;border-radius:2mm;background:#d6d7d4}.photo-empty{display:grid;place-items:center;font-size:6pt;color:#777}.card strong{display:block;color:#8f173d;font-size:8.5pt;text-transform:uppercase}.card span{display:block;margin-top:1.5mm;font-size:7pt}.card em{display:block;margin-top:1.5mm;color:#80756c;font-size:6pt;font-style:normal}.type-chip{display:inline-block!important;width:max-content;padding:1mm 1.5mm;background:#8f173d;color:#fff;font-size:5.5pt!important;font-weight:700}
@media screen{
  html{overflow:auto;background:#dfe4e8}
  body{width:279.4mm;margin:0 auto;background:transparent}
  .page{margin:0 auto 12px;box-shadow:0 5px 20px rgba(35,43,52,.18)}
}
@media print{html,body{width:auto;margin:0;zoom:1!important}.page{margin:0;box-shadow:none}}
</style></head><body class="<%= reference.color?'has-reference-color':'' %>"<% if(reference.color){ %> style="--reference-color:<%= reference.color %>"<% } %>>
<%
 const pageSize=8;
 let folio=1;
%>
<section class="page"><header class="header">PRESIDENCIAS MUNICIPALES · REPORTE POR REFERENTE</header><div class="summary"><div class="map"><%- presidencyMapSvg %></div><aside class="profile"><small>REFERENTE</small><h1><%= reference.nombre %></h1><% if(photo(reference.foto_url)){ %><img class="profile-photo" src="<%= photo(reference.foto_url) %>"><% } else { %><div class="profile-photo profile-placeholder">R</div><% } %><div class="count"><div><span>MUNICIPIOS</span><strong><%= presidencyMunicipalityCount %></strong></div><div><span>PRESIDENCIAS</span><strong><%= presidencyRecords.length %></strong></div></div><% if(reference.variants.length>1){ %><div class="variants">Variantes homologadas: <%= reference.variants.join(' · ') %></div><% } %><% if(reference.posibles_coincidencias.length){ %><div class="variants">Posible coincidencia: <%= reference.posibles_coincidencias.join(' · ') %></div><% } %><% if(reference.requiere_revision){ %><span class="review-note">REQUIERE REVISIÓN DE CAPTURA</span><% } %></aside></div><span class="generated">GENERADO: <%= generatedAt.toUpperCase() %></span><span class="folio"><%= folio++ %></span></section>
<% for(let start=0;start<presidencyRecords.length;start+=pageSize){ const rows=presidencyRecords.slice(start,start+pageSize); %><section class="page detail"><header class="header">PRESIDENCIAS MUNICIPALES · <%= reference.nombre.toUpperCase() %></header><h2>Presidentas y presidentes vinculados por municipio</h2><div class="cards"><% rows.forEach(row=>{ %><article class="card"><span class="municipio"><%= row.municipio.toUpperCase() %></span><% if(photo(row.foto_url)){ %><img src="<%= photo(row.foto_url) %>"><% } else { %><div class="photo-empty">SIN FOTO</div><% } %><div><strong><%= row.nombre %></strong><span class="type-chip"><%= row.tipo_label %></span><span><%= row.partido %></span><em>CLAVE MUNICIPAL <%= row.clave %></em></div></article><% }) %></div><span class="generated">GENERADO: <%= generatedAt.toUpperCase() %></span><span class="folio"><%= folio++ %></span></section><% } %>

<section class="page"><header class="header">DIPUTACIONES FEDERALES Y LOCALES · REPORTE POR REFERENTE</header><div class="summary"><div class="map"><%- deputyMapSvg %></div><aside class="profile"><small>REFERENTE</small><h1><%= reference.nombre %></h1><% if(photo(reference.foto_url)){ %><img class="profile-photo" src="<%= photo(reference.foto_url) %>"><% } else { %><div class="profile-photo profile-placeholder">R</div><% } %><div class="count"><div><span>MUNICIPIOS</span><strong><%= deputyMunicipalityCount %></strong></div><div><span>DIP. FEDERALES</span><strong><%= reference.total_diputaciones_federales %></strong></div><div><span>DIP. LOCALES</span><strong><%= reference.total_diputaciones_locales %></strong></div></div></aside></div><span class="generated">GENERADO: <%= generatedAt.toUpperCase() %></span><span class="folio"><%= folio++ %></span></section>
<% for(let start=0;start<deputyRecords.length;start+=pageSize){ const rows=deputyRecords.slice(start,start+pageSize); %><section class="page detail"><header class="header">DIPUTACIONES FEDERALES Y LOCALES · <%= reference.nombre.toUpperCase() %></header><h2>Diputadas y diputados vinculados por municipio</h2><div class="cards"><% rows.forEach(row=>{ %><article class="card"><span class="municipio"><%= row.municipio.toUpperCase() %></span><% if(photo(row.foto_url)){ %><img src="<%= photo(row.foto_url) %>"><% } else { %><div class="photo-empty">SIN FOTO</div><% } %><div><strong><%= row.nombre %></strong><span class="type-chip"><%= row.tipo_label %></span><span><%= row.partido %></span><em>CLAVE MUNICIPAL <%= row.clave %></em></div></article><% }) %></div><span class="generated">GENERADO: <%= generatedAt.toUpperCase() %></span><span class="folio"><%= folio++ %></span></section><% } %>
</body></html>
