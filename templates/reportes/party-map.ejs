<!doctype html><html lang="es-MX"><head><meta charset="utf-8"><style>
@page{size:390mm 215mm;margin:0}*{box-sizing:border-box}html,body{margin:0;background:#eee7da;color:#86233a;font-family:Arial,sans-serif;-webkit-print-color-adjust:exact;print-color-adjust:exact}.page{width:390mm;height:215mm;position:relative;overflow:hidden;background:#f4eee4}.header{position:absolute;top:0;left:50%;transform:translateX(-50%);width:166mm;height:16mm;padding:4.5mm 8mm;background:#ccb58f;color:#fff;font-size:15pt;font-weight:700;box-shadow:0 2mm 2mm rgba(0,0,0,.18)}.content{height:100%;display:grid;grid-template-columns:2.05fr .95fr;gap:9mm;padding:18mm 39mm 18mm}.map{display:grid;place-items:center}.map svg{width:100%;height:100%;filter:drop-shadow(0 2mm 2mm rgba(75,42,29,.24))}.map-labels text{font-size:4px;font-weight:700;fill:#fff;paint-order:stroke;stroke:#6e2430;stroke-width:1px;stroke-linejoin:round}.summary{display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center}.summary small{font-size:8pt;letter-spacing:.12em;color:#9b7650}.summary h1{margin:3mm 0 7mm;font-size:25pt;line-height:1.05}.swatch{width:28mm;height:28mm;border-radius:7mm;background:<%= party.color||'#AEB6C1' %>;box-shadow:0 0 0 2mm #fff,0 2mm 5mm rgba(0,0,0,.18);display:flex;align-items:center;justify-content:center;gap:1mm;padding:3mm}.swatch img{max-width:100%;max-height:100%;min-width:0;object-fit:contain;background:#fff;border-radius:2mm;padding:1mm}.swatch.multi img{width:30%;height:70%}.count{margin-top:7mm}.count strong{display:block;font-size:34pt;color:<%= party.color||'#7d8792' %>}.count span{display:block;margin-top:1mm;font-size:10pt;color:#756d65}.municipalities{margin-top:6mm;max-width:100%;font-size:7pt;line-height:1.45;color:#756d65}.footer{position:absolute;left:50%;bottom:0;transform:translateX(-50%);width:166mm;height:7mm;background:#941a3d}.generated{position:absolute;left:39mm;bottom:8mm;font-size:6pt;color:#8b8177}.folio{position:absolute;right:32mm;bottom:10mm;color:#a36d31;font-size:11pt;font-weight:700}@media screen{html{overflow:auto;background:#dfe4e8}body{width:390mm;margin:0 auto}.page{margin:0 auto 12px;box-shadow:0 5px 20px rgba(35,43,52,.18)}}@media print{html,body{width:auto;margin:0}.page{margin:0;box-shadow:none}}
</style></head><body><section class="page"><header class="header">PRESIDENCIAS MUNICIPALES · POR PARTIDO POLÍTICO</header><div class="content"><div class="map"><%- mapSvg %></div><aside class="summary"><small>PARTIDO GOBERNANTE</small><h1><%= party.nombre %></h1><div class="swatch <%= party.logos.length>1?'multi':'' %>"><% party.logos.forEach(logo=>{ %><img src="<%= logo %>" alt=""><% }) %></div><div class="count"><strong><%= party.total_municipios %></strong><span>MUNICIPIOS GOBERNADOS</span></div><div class="municipalities"><%= party.municipios.map(item=>item.nombre).join(' · ') %></div></aside></div><span class="generated">GENERADO: <%= generatedAt.toUpperCase() %></span><span class="folio">1</span><div class="footer"></div></section></body></html>
