<!doctype html><html lang="es-MX"><head><meta charset="utf-8"><style>
@page{size:390mm 215mm;margin:0}*{box-sizing:border-box}html,body{margin:0;background:#eee7da;color:#69253a;font-family:Arial,sans-serif;-webkit-print-color-adjust:exact;print-color-adjust:exact}.page{width:390mm;height:215mm;position:relative;overflow:hidden;background:#f4eee4;break-after:page;page-break-after:always}.page:last-child{break-after:auto}.header{position:absolute;top:0;left:50%;transform:translateX(-50%);width:166mm;height:16mm;padding:4mm 8mm;background:#ccb58f;color:#fff;font-size:15pt;font-weight:700;box-shadow:0 2mm 2mm rgba(0,0,0,.18)}.cover{height:100%;display:grid;grid-template-columns:2.1fr .9fr;gap:8mm;padding:18mm 35mm 18mm}.map{display:grid;place-items:center}.map svg{width:100%;height:100%;filter:drop-shadow(0 2mm 2mm rgba(75,42,29,.24))}.map-labels text{font-size:4px;font-weight:700;fill:#fff;paint-order:stroke;stroke:#6e2430;stroke-width:1px}.overview{display:flex;flex-direction:column;justify-content:center}.overview h1{font-size:23pt;margin:0 0 6mm}.overview-grid{display:grid;grid-template-columns:1fr 1fr;gap:3mm}.party-card{display:grid;grid-template-columns:10mm 1fr auto;gap:2mm;align-items:center;padding:2mm 3mm;border-bottom:.4mm solid #d8ccb9}.party-logos{width:10mm;height:7mm;display:flex;align-items:center;gap:.4mm}.party-logos img{max-width:100%;max-height:100%;min-width:0;object-fit:contain}.party-logos.multi img{width:31%}.party-fallback{width:5mm;height:5mm;border-radius:50%}.party-card span{font-size:9pt}.party-card strong{font-size:14pt}.kpi{margin-top:6mm;padding:4mm;background:#fff8;border-left:2mm solid #941a3d}.kpi strong{font-size:24pt}.kpi span{display:block;font-size:8pt}.table-page{padding:22mm 31mm 17mm}.table-page h2{margin:0 0 5mm;font-size:16pt}.party-table{width:100%;border-collapse:collapse;background:#fff9;table-layout:fixed}.party-table th{height:10mm;padding:2mm 3mm;background:#941a3d;color:#fff;text-align:left;font-size:8pt}.party-table td{height:8.2mm;padding:1.6mm 3mm;border-bottom:.3mm solid #d9cebd;font-size:7.5pt}.party-table tr:nth-child(even) td{background:#f1e8da}.num{width:12mm;text-align:center!important}.key{width:20mm}.party{width:48mm;font-weight:700}.footer{position:absolute;left:50%;bottom:0;transform:translateX(-50%);width:166mm;height:7mm;background:#941a3d}.generated{position:absolute;left:31mm;bottom:8mm;font-size:6pt;color:#8b8177}.folio{position:absolute;right:31mm;bottom:9mm;color:#a36d31;font-size:10pt;font-weight:700}@media screen{html{overflow:auto;background:#dfe4e8}body{width:390mm;margin:0 auto}.page{margin:0 auto 12px;box-shadow:0 5px 20px #2333}}@media print{html,body{width:auto;margin:0}.page{margin:0;box-shadow:none}}
</style></head><body>
<% let folio=1; %><section class="page"><header class="header">MUNICIPIOS · DISTRIBUCIÓN POR PARTIDO</header><div class="cover"><div class="map"><%- mapSvg %></div><aside class="overview"><h1>Presidencias municipales por partido político</h1><div class="overview-grid"><% parties.forEach(p=>{ %><div class="party-card"><span class="party-logos <%= p.logos.length>1?'multi':'' %>"><% if(p.logos.length){p.logos.forEach(logo=>{ %><img src="<%= logo %>" alt=""><% })}else{ %><i class="party-fallback" style="background:<%= p.color||'#AEB6C1' %>"></i><% } %></span><span><%= p.nombre %></span><strong><%= p.total_municipios %></strong></div><% }) %></div><div class="kpi"><strong><%= covered %> / <%= rows.length %></strong></div></aside></div><span class="generated">GENERADO: <%= generatedAt.toUpperCase() %></span><span class="folio"><%= folio++ %></span><div class="footer"></div></section>
<% const pageSize=18;for(let start=0;start<rows.length;start+=pageSize){const pageRows=rows.slice(start,start+pageSize); %><section class="page table-page"><header class="header">DIRECTORIO MUNICIPAL · PARTIDOS POLÍTICOS</header><h2>Municipios y presidencias municipales</h2><table class="party-table"><thead><tr><th class="num">N.º</th><th class="key">CLAVE</th><th>MUNICIPIO</th><th>PRESIDENCIA MUNICIPAL</th><th class="party">PARTIDO</th></tr></thead><tbody><% pageRows.forEach((row,index)=>{ %><tr><td class="num"><%= start+index+1 %></td><td><%= row.clave %></td><td><%= row.nombre %></td><td><%= row.presidencia||'SIN CAPTURA' %></td><td class="party"><%= row.partido %></td></tr><% }) %></tbody></table><span class="generated">GENERADO: <%= generatedAt.toUpperCase() %></span><span class="folio"><%= folio++ %></span><div class="footer"></div></section><% } %>
</body></html>
